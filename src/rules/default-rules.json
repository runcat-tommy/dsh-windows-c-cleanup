      "grade": "protected",
      "overridable": false,
      "reason": "npm 配置文件（含 registry/缓存路径设置）"
    },
    {
      "id": "gitconfig-file",
      "path": "%USERPROFILE%\\.gitconfig",
      "kind": "file",
      "grade": "protected",
      "overridable": false,
      "reason": "Git 全局配置"
    },
    {
      "id": "git-credentials-file",
      "path": "%USERPROFILE%\\.git-credentials",
      "kind": "file",
      "grade": "protected",
      "overridable": false,
      "reason": "Git 凭据文件"
    },
    {
      "id": "lark-user-data",
