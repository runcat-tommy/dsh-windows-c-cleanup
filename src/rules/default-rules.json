      "reason": "企业微信聊天记录与文件数据（其 upgrade/Log 子目录另有 safe 规则覆盖）"
    },
    {
      "id": "wemail-data",
      "path": "%APPDATA%\\Tencent\\WeMail",
      "grade": "protected",
      "overridable": false,
      "reason": "腾讯邮箱客户端数据"
    },
    {
      "id": "wemeet-data",
      "path": "%APPDATA%\\Tencent\\WeMeet",
      "grade": "protected",
      "overridable": false,
      "reason": "腾讯会议本地数据"
    },
    {
      "id": "qq-data",
      "path": "%APPDATA%\\Tencent\\QQ",
      "grade": "protected",
      "overridable": false,
      "reason": "QQ 聊天与文件数据"
