{
  "name": "dsh-windows-c-cleanup",
  "version": "0.4.2",
  "description": "DSH 插件：Windows 系统盘清理能力 —— 扫描 → 五级分级（可安全删除/谨慎删除/建议迁移/保护名单/长期防护）→ 用户确认 → 分层执行与迁移",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src/rules/default-rules.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx tests/smoke.ts",
    "m2": "tsx tests/m2-execute.ts",
    "m3": "tsx tests/m3-migrate.ts",
    "m4": "tsx tests/m4-history.ts",
    "m4:live": "tsx tests/m4-live-schedule.ts",
    "m5": "tsx tests/m5-panel.ts",
    "scan": "tsx tests/tool-run.ts full",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "disk-cleanup",
    "windows",
    "c-drive"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
